# Jericho Platform — local environment.
#
# Copy this file to .env and fill in the real values:
#     cp .env.example .env
#
# .env is git-ignored and must NEVER be committed or pasted into a chat.
# Both secrets below bypass Row Level Security completely.

# --- Safe to be public (already in js/supabase-config.js) ---------------------
SUPABASE_URL=https://coarclhafggkakmpggfh.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_gDvKmt06iRiRYmDSYXv7Mg_XARxm2o0

# --- SECRET: bypasses RLS. Never commit, never paste in chat. ----------------
# Supabase Dashboard -> Project Settings -> API -> service_role / secret key.
SUPABASE_SERVICE_ROLE_KEY=

# --- SECRET: full database access. Never commit, never paste in chat. --------
# Supabase Dashboard -> Connect (top bar) -> copy the connection string.
# Copy it EXACTLY as shown there rather than composing it by hand; Supabase
# has changed the host/username format over time and the dashboard is the
# authority on the current one.
# It looks roughly like:
#   postgresql://postgres.<ref>:<password>@<host>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# Operator account bootstrapped by scripts/bootstrap-operator.sh
OPERATOR_EMAIL=rafael.e@telenet.be

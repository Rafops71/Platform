    "e2e:ui": "playwright test --ui",
    "checklist": "node scripts/checklist-report.js",
    "why": "node scripts/why-failed.js",
    "check:guards": "node scripts/check-render-guards.js",
    "check:migrations": "node scripts/check-migration-lists.js",
